{
  "name": "agentern",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "clean:generated": "node scripts/clean-generated.mjs",
    "check:unused": "knip",
    "dev": "turbo dev",
    "db:generate": "pnpm --filter @workspace/db generate",
    "db:migrate": "pnpm --filter @workspace/db migrate",
    "db:seed": "pnpm --filter @workspace/db seed",
    "db:seed:load": "pnpm --filter @workspace/db seed:load",
    "db:admin": "pnpm --filter @workspace/db admin",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "pnpm --filter web test:e2e",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "knip": "^6.27.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.7",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.12",
      "brace-expansion": "5.0.8",
      "esbuild": "0.25.12",
      "fast-uri": "3.1.4",
      "js-yaml": "5.2.2",
      "postcss": "8.5.19",
      "sharp": "0.35.3"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
